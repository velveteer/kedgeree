cabal-version:      2.4
name:               kedgeree
version:            0.1.0
synopsis:           A modern theme for Haddock documentation
description:
  Kedgeree post-processes generated Haddock HTML in place to give it a modern
  look: a light/dark/auto theme, a sticky sidebar with scroll-spy, keyboard
  search, bundled fonts, and polished hyperlinked-source pages.
  .
  It is a single self-contained binary with the theme assets embedded. Run it
  on a @doc/html/\<pkg>@ directory from @cabal haddock@, or on a whole
  multi-package tree from @cabal haddock-project@ or @stack haddock@, where it
  can also generate a landing page listing every package. Runs are idempotent,
  so it is safe to re-run after regenerating the docs.
  .
  See the <https://github.com/velveteer/kedgeree#readme README> for usage.

license:            BSD-3-Clause
license-file:       LICENSE
author:             Josh Miller
maintainer:         joshua.ian.miller@pm.me
copyright:          2026 Josh Miller
category:           Development, Documentation
homepage:           https://github.com/velveteer/kedgeree
bug-reports:        https://github.com/velveteer/kedgeree/issues
build-type:         Simple
tested-with:
  GHC ==9.6.7 || ==9.10.3 || ==9.12.2 || ==9.14.1

extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/*.html
  test/fixtures/src/*.html
  test/golden/*.html
  assets/kedgeree.css
  assets/kedgeree-source.css
  assets/kedgeree-tokens.css
  assets/kedgeree.js
  assets/kedgeree-logo.svg
  assets/fonts/*.woff2
  assets/icons/*.svg

source-repository head
  type:     git
  location: https://github.com/velveteer/kedgeree.git

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.18 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Kedgeree.Assets
    Kedgeree.Chrome
    Kedgeree.Haddock
    Kedgeree.Html
    Kedgeree.Inject
    Kedgeree.Landing
    Kedgeree.Process
    Kedgeree.Rewrite
    Kedgeree.Sidebar
    Kedgeree.Signature

  other-modules:    Paths_kedgeree
  autogen-modules:  Paths_kedgeree
  build-depends:
      async                 >=2.2  && <2.3
    , bytestring            >=0.11 && <0.13
    , containers            >=0.6  && <0.9
    , directory             >=1.3  && <1.4
    , file-embed            >=0.0.10 && <0.1
    , filepath              >=1.4  && <1.6
    , lucid2                >=0.0  && <0.1
    , tagsoup               >=0.14 && <0.15
    , text                  >=2.0  && <2.2

executable kedgeree
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
      kedgeree
    , optparse-applicative  >=0.16 && <0.20
    , text

  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"

test-suite kedgeree-test
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
      bytestring
    , directory
    , filepath
    , kedgeree
    , text
